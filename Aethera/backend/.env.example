# ──────────────────────────────────────────
# MindSpark Backend — Environment Variables
# ──────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Secret used to sign JSON Web Tokens (change this in production!)
JWT_SECRET=change-me-to-a-strong-random-secret

# Port the Express server listens on
PORT=34567

# Groq API key used by the backend to proxy completions requests
# Obtain your key from https://console.groq.com/
GROQ_API_KEY=gsk_your_real_api_key_here

# SMTP Server Configurations (Optional, logs to console if empty)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="MindSpark <no-reply@mindspark.edu>"

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
